FROM python:3.12-slim

WORKDIR /app

COPY requirements-ui.txt .
RUN pip install --no-cache-dir --trusted-host pypi.org --trusted-host files.pythonhosted.org -r requirements-ui.txt

COPY ui/ ui/
COPY reports/ reports/

EXPOSE 8501
CMD ["streamlit", "run", "ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
